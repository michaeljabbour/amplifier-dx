/*
 * Amplifier Session Lifecycle
 *
 * Source: github.com/microsoft/amplifier-core/CONTRACTS.md
 *
 * From bundle load -> mount -> session ready -> execute -> teardown.
 */
digraph SessionLifecycle {
    rankdir=TB;
    bgcolor="white";
    pad=0.3;
    nodesep=0.3;
    ranksep=0.4;

    node [
        shape=box,
        style="filled,rounded",
        fontname="Helvetica",
        fontsize=10,
        margin="0.2,0.1",
        penwidth=1.2
    ];

    edge [
        fontname="Helvetica",
        fontsize=9,
        color="#666666",
        penwidth=1.1
    ];

    // === STARTUP PHASE ===
    subgraph cluster_startup {
        label=<<B>1. Startup</B>>;
        labeljust=l;
        fontsize=11;
        color="#cccccc";
        style="rounded,filled";
        fillcolor="#fafafa";

        load    [label="Bundle loaded\\n(YAML + markdown)", fillcolor="#e2dcfc"];
        compose [label="Mount Plan composed\\n(merged config)", fillcolor="#e2dcfc"];
        mount   [label="Modules mounted\\nin phase order\\n(mount() called per module)", fillcolor="#dcf2dc"];
        ready   [label="on_session_ready()\\nfires for each module\\n(coordinator fully composed)", fillcolor="#dcf2dc"];

        load -> compose -> mount -> ready;
    }

    // === EXECUTION PHASE ===
    subgraph cluster_exec {
        label=<<B>2. Execute (per turn)</B>>;
        labeljust=l;
        fontsize=11;
        color="#cccccc";
        style="rounded,filled";
        fillcolor="#fafafa";

        prompt   [label="session.execute(prompt)", fillcolor="#dceefc", shape=cds, width=2.5];
        loop_in  [label="Orchestrator runs\\nthe loop", fillcolor="#fce8d2"];
        llm_req  [label="LLM request\\n[event: llm:request]", fillcolor="#fff8d2"];
        provider [label="Provider.complete()", fillcolor="#dceefc"];
        llm_res  [label="LLM response\\n[event: llm:response]", fillcolor="#fff8d2"];
        tool_dec [label="Tool calls?", shape=diamond, fillcolor="#ffffff"];
        tool_pre [label="[event: tool:pre]\\nhooks may deny / modify", fillcolor="#fff8d2"];
        tool_run [label="Tool.execute()", fillcolor="#dcf2dc"];
        tool_post [label="[event: tool:post]\\nhooks observe", fillcolor="#fff8d2"];
        finish   [label="Final response", fillcolor="#dceefc", shape=cds, width=2.0];

        prompt -> loop_in -> llm_req -> provider -> llm_res -> tool_dec;
        tool_dec -> tool_pre [label=" yes "];
        tool_pre -> tool_run -> tool_post -> loop_in [label=" next iteration "];
        tool_dec -> finish [label=" no "];
    }

    // === TEARDOWN PHASE ===
    subgraph cluster_tear {
        label=<<B>3. Teardown</B>>;
        labeljust=l;
        fontsize=11;
        color="#cccccc";
        style="rounded,filled";
        fillcolor="#fafafa";

        cleanup [label="Cleanup callables\\n(reverse registration order)", fillcolor="#fcdedc"];
        end     [label="[event: session:end]", fillcolor="#fff8d2"];
        cleanup -> end;
    }

    // === INTER-PHASE FLOW ===
    ready  -> prompt [label=" ready for prompts "];
    finish -> cleanup [label=" session ends "];
}
