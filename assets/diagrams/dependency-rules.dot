/*
 * Amplifier Repository Dependency Rules
 *
 * Source: github.com/microsoft/amplifier/docs/REPOSITORY_RULES.md
 *
 * Green = allowed. Red = forbidden.
 * Modules depend ONLY on the kernel; never on peers or higher layers.
 */
digraph DependencyRules {
    rankdir=BT;
    bgcolor="#151618";
    fontname="Helvetica";
    fontcolor="#cdc8bc";
    pad=0.3;
    nodesep=0.5;
    ranksep=0.7;

    node [
        shape=box,
        fontcolor="#efeadf",
        color="#4a4d51",
        fillcolor="#232527",
        style="filled,rounded",
        fontname="Helvetica",
        fontsize=10,
        margin="0.2,0.12",
        penwidth=1.3
    ];

    edge [
        color="#75716a",
        fontname="Helvetica",
        fontcolor="#9b968b",
        fontsize=9,
        penwidth=1.5
    ];

    // === REPO TYPES ===
    kernel [label=<<B>amplifier-core</B><BR/><FONT POINT-SIZE="8">Kernel</FONT>>, fillcolor="#f2a93b", color="#f2a93b", fontcolor="#1a1b1d"];
    entry  [label=<<B>amplifier</B><BR/><FONT POINT-SIZE="8">Entry point / docs</FONT>>, fillcolor="#232527", color="#75716a"];
    foundation [label=<<B>amplifier-foundation</B><BR/><FONT POINT-SIZE="8">Library</FONT>>, fillcolor="#33271d", color="#ea9a62"];

    module_a [label=<<B>amplifier-module-tool-bash</B><BR/><FONT POINT-SIZE="8">Module</FONT>>, fillcolor="#1f2d25", color="#86c49a"];
    module_b [label=<<B>amplifier-module-tool-filesystem</B><BR/><FONT POINT-SIZE="8">Module</FONT>>, fillcolor="#1f2d25", color="#86c49a"];

    bundle [label=<<B>amplifier-bundle-recipes</B><BR/><FONT POINT-SIZE="8">Bundle</FONT>>, fillcolor="#2a2535", color="#b9a2dc"];
    app    [label=<<B>amplifier-app-cli</B><BR/><FONT POINT-SIZE="8">Application</FONT>>, fillcolor="#1f2a35", color="#7fb0dd"];

    // === ALLOWED EDGES (green) ===
    foundation -> kernel [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    foundation -> entry  [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];

    module_a -> kernel [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    module_b -> kernel [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];

    bundle -> foundation [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    bundle -> module_a   [color="#86c49a", label=" ✓ references ", fontcolor="#86c49a"];

    app -> foundation [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    app -> bundle     [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    app -> module_a   [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];
    app -> kernel     [color="#86c49a", label=" ✓ ", fontcolor="#86c49a"];

    // === FORBIDDEN EDGES (red, dashed) ===
    module_a -> module_b   [color="#e2776b", style=dashed, label=" ✗ modules\ncannot reference\npeers ", fontcolor="#e2776b"];
    module_a -> foundation [color="#e2776b", style=dashed, label=" ✗ ", fontcolor="#e2776b"];
    module_a -> app        [color="#e2776b", style=dashed, label=" ✗ ", fontcolor="#e2776b"];
    kernel   -> foundation [color="#e2776b", style=dashed, label=" ✗ kernel knows nothing\nbelow entry point ", fontcolor="#e2776b"];

    // === CALLOUT ===
    note [
        shape=plaintext,
        style="",
        label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#1a1b1d" COLOR="#4a4d51">
            <TR><TD ALIGN="LEFT"><B>The Import Rule</B></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">When a module needs something from</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">an app or library, it uses the kernel's</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">capability registry instead of importing.</FONT></TD></TR>
        </TABLE>>
    ];
}
