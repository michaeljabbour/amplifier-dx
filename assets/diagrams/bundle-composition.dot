/*
 * Amplifier Bundle Composition
 *
 * Source: github.com/microsoft/amplifier-foundation/docs/BUNDLE_GUIDE.md
 *
 * Behavior-first composition: a complete root (Anchors, the recommended base
 * for a new host; "foundation" remains a selectable legacy root) plus a
 * behavior, with app bundles and settings providers composed afterwards.
 */
digraph BundleComposition {
    rankdir=LR;
    bgcolor="white";
    pad=0.3;
    nodesep=0.4;
    ranksep=0.6;
    compound=true;

    node [
        shape=box,
        style="filled,rounded",
        fontname="Helvetica",
        fontsize=10,
        margin="0.2,0.12",
        penwidth=1.3
    ];

    edge [
        fontname="Helvetica",
        fontsize=9,
        color="#666666",
        penwidth=1.2
    ];

    // === BASE ROOT (Anchors) ===
    subgraph cluster_base {
        label=<<B>Complete root: Anchors</B><BR/><FONT POINT-SIZE="9">amplifier-foundation: bundles/anchors/bundle.md<BR/>(foundation is the selectable legacy root)</FONT>>;
        labeljust=l;
        fontsize=11;
        color="#c87a3a";
        style="rounded,filled";
        fillcolor="#fff5e8";

        base_orch [label=<<B>session</B><BR/><FONT POINT-SIZE="9">orchestrator +<BR/>context manager</FONT>>, fillcolor="#fce8d2"];
        base_tool [label=<<B>tools</B><BR/><FONT POINT-SIZE="9">tool-recipes, tool-mode, &#8230;</FONT>>, fillcolor="#dcf2dc"];
        base_hook [label=<<B>hooks</B><BR/><FONT POINT-SIZE="9">hooks-mode, hooks-approval,<BR/>hooks-routing, &#8230;</FONT>>, fillcolor="#e2dcfc"];
        base_agents [label=<<B>agents</B><BR/><FONT POINT-SIZE="9">anchors:explorer, architect,<BR/>builder, debugger,<BR/>git-ops, researcher</FONT>>, fillcolor="#fcdedc"];
    }

    // === BEHAVIOR ===
    subgraph cluster_behavior {
        label=<<B>Behavior</B><BR/><FONT POINT-SIZE="9">amplifier-bundle-browser-tester<BR/>behaviors/browser-tester.yaml</FONT>>;
        labeljust=l;
        fontsize=11;
        color="#7059c8";
        style="rounded,filled";
        fillcolor="#f7f3ff";

        beh_tool [label=<<B>tools / hooks</B><BR/><FONT POINT-SIZE="9">optional</FONT>>, fillcolor="#dcf2dc"];
        beh_agent [label=<<B>agents</B><BR/><FONT POINT-SIZE="9">agents.include</FONT>>, fillcolor="#fcdedc"];
        beh_ctx  [label=<<B>context</B><BR/><FONT POINT-SIZE="9">context.include</FONT>>, fillcolor="#f0e8ff"];
    }

    // === COMPOSED BY THE APP, AFTER THE SELECTED BUNDLE ===
    subgraph cluster_app {
        label=<<B>Added by the app</B><BR/><FONT POINT-SIZE="9">composed after the selected bundle</FONT>>;
        labeljust=l;
        fontsize=11;
        color="#3a86c8";
        style="rounded,filled";
        fillcolor="#f2f8fe";

        app_beh  [label=<<B>app bundles</B><BR/><FONT POINT-SIZE="9">settings: bundle.app<BR/>amplifier bundle add &#8230; --app</FONT>>, fillcolor="#f0e8ff"];
        app_prov [label=<<B>providers</B><BR/><FONT POINT-SIZE="9">settings: config.providers,<BR/>or a provider bundle<BR/>(foundation:providers/anthropic-sonnet)</FONT>>, fillcolor="#dceefc"];
    }

    // === MOUNT PLAN ===
    plan [
        label=<<B>Mount Plan</B><BR/><FONT POINT-SIZE="9">merged config<BR/>passed to AmplifierSession</FONT>>,
        fillcolor="#3a3a3a",
        fontcolor="white",
        shape=box3d,
        width=2.0
    ];

    // === SESSION ===
    session [
        label=<<B>AmplifierSession</B><BR/><FONT POINT-SIZE="9">running instance</FONT>>,
        fillcolor="#dceefc",
        shape=cds,
        width=2.0
    ];

    // === ROOT BUNDLE ===
    root [
        label=<<B>Your bundle</B><BR/><FONT POINT-SIZE="9">(optional supporting root)<BR ALIGN="LEFT"/>includes:<BR ALIGN="LEFT"/>&nbsp;&nbsp;- bundle: git+https://github.com/microsoft/amplifier-foundation@main<BR ALIGN="LEFT"/>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#subdirectory=bundles/anchors/bundle.md<BR ALIGN="LEFT"/>&nbsp;&nbsp;- bundle: git+https://github.com/microsoft/amplifier-bundle-browser-tester@main<BR ALIGN="LEFT"/>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#subdirectory=behaviors/browser-tester.yaml<BR ALIGN="LEFT"/></FONT>>,
        fillcolor="#fffae0",
        shape=note
    ];

    // === EDGES ===
    root -> base_orch [lhead=cluster_base, label=" includes "];
    root -> beh_tool  [lhead=cluster_behavior, label=" includes "];

    base_orch -> plan;
    base_tool -> plan;
    base_hook -> plan;
    base_agents -> plan;
    beh_tool -> plan;
    beh_agent -> plan;
    beh_ctx -> plan;
    app_beh -> plan [style=dashed];
    app_prov -> plan [style=dashed];

    plan -> session [label=" creates "];

    // === MERGE RULES NOTE ===
    rules [
        shape=plaintext,
        label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffaf0">
            <TR><TD COLSPAN="2" BGCOLOR="#f0e8d8" ALIGN="LEFT"><B>Merge rules</B></TD></TR>
            <TR><TD ALIGN="LEFT">providers, tools, hooks</TD><TD ALIGN="LEFT">merged by module ID</TD></TR>
            <TR><TD ALIGN="LEFT">session (orchestrator, context)</TD><TD ALIGN="LEFT">deep merge, later wins</TD></TR>
            <TR><TD ALIGN="LEFT">spawn</TD><TD ALIGN="LEFT">deep merge</TD></TR>
            <TR><TD ALIGN="LEFT">agents</TD><TD ALIGN="LEFT">merged by name, later wins</TD></TR>
            <TR><TD ALIGN="LEFT">context</TD><TD ALIGN="LEFT">accumulated</TD></TR>
            <TR><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">replaced, later wins</TD></TR>
        </TABLE>>
    ];
}
