/*
 * Amplifier Module Types
 *
 * Six module types are recognized by the kernel's ModuleType literal.
 * Five ship with public contract docs; "resolver" is recognized internally
 * but does not yet have a public contract doc.
 *
 * Sources:
 *   amplifier-core/CONTRACTS.md line 55 (ModuleType literal)
 *   amplifier-core/CONTRACTS.md lines 28–38 (Trait↔Protocol mapping)
 *   amplifier-core/context/kernel-overview.md lines 99–158
 *   amplifier-core/docs/DESIGN_PHILOSOPHY.md line 204 (six gRPC bridges)
 *
 * Verified 2026-05-02 by core:core-expert (cross-checked against
 * a DOT source in a private curriculum repository).
 * Re-verified 2026-11-18 against amplifier-core 2.0.2.
 */
digraph ModuleTypes {
    rankdir=LR;
    bgcolor="#151618";
    fontname="Helvetica";
    fontcolor="#cdc8bc";
    pad=0.3;
    nodesep=0.4;
    ranksep=0.6;

    node [
        shape=box,
        fontcolor="#efeadf",
        color="#4a4d51",
        fillcolor="#232527",
        style="filled,rounded",
        fontname="Helvetica",
        fontsize=10,
        margin="0.2,0.12",
        penwidth=1.3
    ];

    edge [
        fontname="Helvetica",
        fontcolor="#9b968b",
        fontsize=9,
        color="#75716a",
        arrowhead=none
    ];

    // === KERNEL ===
    kernel [
        label=<<B>amplifier-core</B><BR/><FONT POINT-SIZE="9">Defines protocols.<BR/>Loads modules.<BR/>Dispatches events.</FONT>>,
        fillcolor="#f2a93b", color="#f2a93b",
        fontcolor="#1a1b1d",
        width=2.2
    ];

    // === FIVE CONTRACT-DOCUMENTED TYPES ===
    provider [
        label=<<B>Provider</B><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">LLM backend<BR/>complete(req)&rarr;resp<BR/><I>anthropic, openai, gemini,<BR/>azure, ollama, vllm, &#8230;</I></FONT>>,
        fillcolor="#1f2a35",
        color="#7fb0dd"
    ];

    tool [
        label=<<B>Tool</B><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">LLM-decided capability<BR/>execute(input)&rarr;result<BR/><I>filesystem, bash, web,<BR/>search, task, todo, &#8230;</I></FONT>>,
        fillcolor="#1f2d25",
        color="#86c49a"
    ];

    orchestrator [
        label=<<B>Orchestrator</B><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">Execution loop strategy<BR/>execute(prompt)&rarr;str<BR/><I>loop-basic<BR/>loop-streaming<BR/>loop-events</I></FONT>>,
        fillcolor="#33271d",
        color="#ea9a62"
    ];

    context [
        label=<<B>Context Manager</B><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">Conversation memory<BR/>add/get/set messages<BR/><I>context-simple<BR/>context-persistent</I></FONT>>,
        fillcolor="#33211f",
        color="#e2776b"
    ];

    hook [
        label=<<B>Hook</B><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">Code-decided observer<BR/>__call__(event,data)<BR/><I>logging, redaction,<BR/>approval, streaming-ui, &#8230;</I></FONT>>,
        fillcolor="#2a2535",
        color="#b9a2dc"
    ];

    // === SIXTH TYPE — RECOGNIZED BUT UNDOCUMENTED ===
    resolver [
        label=<<B>Resolver</B>  <FONT POINT-SIZE="8">⚠ advanced / internal</FONT><BR/><FONT POINT-SIZE="9" COLOR="#9b968b">Declared in <I>ModuleType</I> literal.<BR/>Public contract doc not yet<BR/>published. Treat as internal<BR/>extension surface.</FONT>>,
        fillcolor="#232527",
        color="#75716a",
        style="rounded,filled,dashed",
        fontcolor="#cdc8bc"
    ];

    // === EDGES ===
    kernel -> provider     [label=" defines protocol "];
    kernel -> tool         [label=" defines protocol "];
    kernel -> orchestrator [label=" defines protocol "];
    kernel -> context      [label=" defines protocol "];
    kernel -> hook         [label=" defines protocol "];
    kernel -> resolver     [label=" recognizes ", style=dashed, color="#75716a", fontcolor="#9b968b"];

    // === DISTINCTION CALLOUT ===
    distinction [
        shape=plaintext,
        style="",
        label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#1a1b1d" COLOR="#4a4d51">
            <TR>
                <TD BGCOLOR="#2e3033" COLSPAN="2" ALIGN="LEFT"><B>Tool vs Hook: triggering difference</B></TD>
            </TR>
            <TR>
                <TD ALIGN="LEFT"><B>Tool</B></TD>
                <TD ALIGN="LEFT">LLM-decided. Agent calls it.</TD>
            </TR>
            <TR>
                <TD ALIGN="LEFT"><B>Hook</B></TD>
                <TD ALIGN="LEFT">Code-decided. Fires on lifecycle event.</TD>
            </TR>
            <TR>
                <TD ALIGN="LEFT"><B>Orchestrator</B></TD>
                <TD ALIGN="LEFT">The main engine. Drives the loop.</TD>
            </TR>
        </TABLE>>
    ];
}
