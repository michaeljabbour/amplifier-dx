/*
 * Amplifier Hook Event Flow
 *
 * Source: github.com/microsoft/amplifier-core/docs/HOOKS_API.md
 *
 * Shows how a single event fans out to multiple hook handlers, and the
 * action precedence that determines what happens to the operation.
 */
digraph HookFlow {
    rankdir=LR;
    bgcolor="#151618";
    fontname="Helvetica";
    fontcolor="#cdc8bc";
    pad=0.3;
    nodesep=0.3;
    ranksep=0.5;

    node [
        shape=box,
        fontcolor="#efeadf",
        color="#4a4d51",
        fillcolor="#232527",
        style="filled,rounded",
        fontname="Helvetica",
        fontsize=10,
        margin="0.18,0.1",
        penwidth=1.2
    ];

    edge [
        fontname="Helvetica",
        fontcolor="#9b968b",
        fontsize=9,
        color="#75716a",
        penwidth=1.1
    ];

    // === EMITTER ===
    emitter [
        label=<<B>Orchestrator</B><BR/><FONT POINT-SIZE="9">about to call a tool</FONT>>,
        fillcolor="#33271d", color="#ea9a62"
    ];

    event [
        label=<<B>event:</B> tool:pre<BR/><FONT POINT-SIZE="9">data: { tool_name, tool_input }</FONT>>,
        fillcolor="#2d2a1f", color="#e3c58c",
        shape=cds,
        width=2.4
    ];

    // === HOOKS (run in priority order) ===
    subgraph cluster_hooks {
        label=<<B>Registered hooks (lower priority number runs first)</B>>;
        labeljust=l;
        fontsize=11;
        color="#323437";
        style="rounded,filled";
        fillcolor="#1a1b1d";

        h_log    [label="Handler C\n(priority 100)", fillcolor="#2a2535", color="#b9a2dc"];
        h_redact [label="Handler B\n(priority 10)", fillcolor="#2a2535", color="#b9a2dc"];
        h_approval [label="Handler A\n(priority -10)", fillcolor="#2a2535", color="#b9a2dc"];
    }

    // === HOOK ACTIONS ===
    subgraph cluster_actions {
        label=<<B>Possible HookResult actions</B>>;
        labeljust=l;
        fontsize=11;
        color="#323437";
        style="rounded,filled";
        fillcolor="#1a1b1d";

        a_continue [label="continue\nproceed normally", fillcolor="#1f2d25", color="#86c49a"];
        a_modify   [label="modify\ntransform data", fillcolor="#1f2a35", color="#7fb0dd"];
        a_inject   [label="inject_context\nadd msg to agent", fillcolor="#33271d", color="#ea9a62"];
        a_ask      [label="ask_user\napproval gate", fillcolor="#2d2a1f", color="#e3c58c"];
        a_deny     [label="deny\nblock the op", fillcolor="#33211f", color="#e2776b"];
    }

    // === RESULT NODE ===
    result [
        label=<<B>Tool executes</B><BR/><FONT POINT-SIZE="9">(or is blocked)</FONT>>,
        fillcolor="#1f2d25", color="#86c49a",
        shape=cds,
        width=2.0
    ];

    // === EDGES ===
    emitter -> event [label=" emits "];
    event -> h_approval [label=" 1 "];
    h_approval -> h_redact [label=" 2 "];
    h_redact -> h_log [label=" 3 "];

    h_approval -> a_ask [style=dotted];
    h_approval -> a_deny [style=dotted];
    h_redact -> a_modify [style=dotted];
    h_log -> a_continue [style=dotted];

    a_continue -> result;
    a_modify -> result;
    a_inject -> result;
    a_ask -> result [label=" if approved "];
    a_deny -> result [label=" ✗ blocked ", color="#e2776b", fontcolor="#e2776b"];

    // === PRECEDENCE NOTE ===
    precedence [
        shape=plaintext,
        style="",
        label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#1a1b1d" COLOR="#4a4d51">
            <TR><TD BGCOLOR="#2e3033" ALIGN="LEFT"><B>Action precedence</B></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">deny &gt; ask_user &gt; inject_context</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;&nbsp;&nbsp;&nbsp;&gt; modify &gt; continue</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">If any hook returns deny, the</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">operation is blocked.</FONT></TD></TR>
        </TABLE>>
    ];
}
